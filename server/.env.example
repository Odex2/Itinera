# Copy to server/.env and fill in your own keys.
PORT=3001

# Regolo.ai (OpenAI-compatible API, used for all AI agents and speech-to-text)
REGOLO_API_KEY=your_regolo_api_key

# ElevenLabs text-to-speech (optional: voice features are disabled without it)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# OpenWeather (optional: weather-aware exploration)
OPENWEATHER_API_KEY=your_openweather_api_key
